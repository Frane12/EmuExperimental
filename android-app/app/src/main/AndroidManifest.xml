<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <application
        android:name=".DrnasApplication"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_blender_launcher"
        android:roundIcon="@mipmap/ic_blender_launcher"
        android:extractNativeLibs="true"
        android:label="${appLabel}"
        android:usesCleartextTraffic="false"
        android:theme="@style/DrnasTheme">
        <activity android:name=".XInputLayoutEditorActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".WineGuiActivity" android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".BlenderLauncherActivity"
            android:screenOrientation="landscape"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>


